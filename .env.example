# Copy this file to .env at the project root and fill in the values you have.
# The Settings page writes to this same file, so pasting keys there is
# equivalent to editing it by hand - and takes effect without a restart.

# Groq API key - REQUIRED. Used for Whisper transcription and for the notes.
# Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Hugging Face access token - needed only for speaker identification, which
# runs the pyannote models locally. The token owner must have accepted the
# terms for BOTH pyannote/speaker-diarization-3.1 and pyannote/segmentation-3.0.
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional ISO-639-1 hint for Whisper, e.g. "en". Leave empty to auto-detect.
# The language hint on the Settings page overrides this when it is set.
TRANSCRIPT_LANGUAGE=
